# Local dev: Vite proxies /gateway to http://localhost:5000.
# Production: replace this with deployed API Gateway URL.
VITE_API_GATEWAY_URL=/gateway

# Direct-service fallback when VITE_USE_GATEWAY=false.
VITE_APPOINTMENT_SERVICE_URL=/n1
VITE_MEDICAL_RECORD_SERVICE_URL=/n2
VITE_PHARMACY_BILLING_SERVICE_URL=/n3

VITE_USE_GATEWAY=true
VITE_USE_MOCK_N3=true