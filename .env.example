# Local dev: Vite proxies these paths to https://api.hwpresents.site.
VITE_API_GATEWAY_URL=https://api.hwpresents.site

# Direct-service fallback when VITE_USE_GATEWAY=false.
VITE_APPOINTMENT_SERVICE_URL=https://api.hwpresents.site/appointment
VITE_MEDICAL_RECORD_SERVICE_URL=https://api.hwpresents.site/medical
VITE_PHARMACY_BILLING_SERVICE_URL=https://api.hwpresents.site/pharmacy

VITE_USE_GATEWAY=true

# Bank transfer QR for patient invoice payments.
# Bank code follows SePay/VietQR bank short name, for example Techcombank.
VITE_BANK_TRANSFER_BANK=Techcombank
VITE_BANK_TRANSFER_ACCOUNT=
VITE_BANK_TRANSFER_ACCOUNT_NAME=MedicareDNU
VITE_BANK_TRANSFER_PREFIX=MEDDNU

# DogkyChatbot Gemini API key. Frontend env values are public in built assets.
VITE_GEMINI_API_KEY=
